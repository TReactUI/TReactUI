{
  "name": "@trectui/demo",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "targets": {
      "build-dev": {
        "executor": "nx:run-commands",
        "outputs": [
          "{workspaceRoot}/apps/demo/dist-dev"
        ],
        "options": {
          "command": "vite build --mode dev --outDir dist-dev",
          "cwd": "apps/demo"
        }
      },
      "build-uat": {
        "executor": "nx:run-commands",
        "outputs": [
          "{workspaceRoot}/apps/demo/dist-uat"
        ],
        "options": {
          "command": "vite build --mode uat --outDir dist-uat",
          "cwd": "apps/demo"
        }
      },
      "build-prod": {
        "executor": "nx:run-commands",
        "outputs": [
          "{workspaceRoot}/apps/demo/dist-prod"
        ],
        "options": {
          "command": "vite build --mode prod --outDir dist-prod",
          "cwd": "apps/demo"
        }
      },
      "package": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build-dev",
          "build-uat",
          "build-prod"
        ],
        "outputs": [
          "{workspaceRoot}/dist/drop/react-app-demo-dev.zip",
          "{workspaceRoot}/dist/drop/react-app-demo-uat.zip",
          "{workspaceRoot}/dist/drop/react-app-demo-prod.zip"
        ],
        "options": {
          "command": "node -e \"const fs=require('node:fs');fs.mkdirSync('dist/drop',{recursive:true});const A=require('adm-zip');let z;z=new A();z.addLocalFolder('apps/demo/dist-dev');z.writeZip('dist/drop/react-app-demo-dev.zip');z=new A();z.addLocalFolder('apps/demo/dist-uat');z.writeZip('dist/drop/react-app-demo-uat.zip');z=new A();z.addLocalFolder('apps/demo/dist-prod');z.writeZip('dist/drop/react-app-demo-prod.zip')\""
        }
      }
    }
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@trectui/tty": "*"
  }
}
