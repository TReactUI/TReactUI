{
  "folders": [
    {
      "path": ".",
      "name": "trectui"
    }
  ],
  "settings": {
    "eslint.validate": [
      "javascript",
      "javascriptreact",
      "typescript",
      "typescriptreact",
      "json",
      "jsonc",
      "yaml",
      "markdown",
      "css",
      "html",
      "toml"
    ],
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit"
    },
    "editor.defaultFormatter": "dbaeumer.vscode-eslint",
    "editor.formatOnSave": true,
    "[javascript]": {
      "editor.defaultFormatter": "dbaeumer.vscode-eslint"
    },
    "[javascriptreact]": {
      "editor.defaultFormatter": "dbaeumer.vscode-eslint"
    },
    "[typescript]": {
      "editor.defaultFormatter": "dbaeumer.vscode-eslint"
    },
    "[typescriptreact]": {
      "editor.defaultFormatter": "dbaeumer.vscode-eslint"
    },
    "[json]": {
      "editor.defaultFormatter": "dbaeumer.vscode-eslint"
    },
    "[jsonc]": {
      "editor.defaultFormatter": "dbaeumer.vscode-eslint"
    },
    "[yaml]": {
      "editor.defaultFormatter": "dbaeumer.vscode-eslint"
    },
    "[markdown]": {
      "editor.defaultFormatter": "dbaeumer.vscode-eslint"
    },
    "[css]": {
      "editor.defaultFormatter": "dbaeumer.vscode-eslint"
    },
    "[html]": {
      "editor.defaultFormatter": "dbaeumer.vscode-eslint"
    },
    "[toml]": {
      "editor.defaultFormatter": "dbaeumer.vscode-eslint"
    }
  },
  "extensions": {
    "recommendations": [
      "dbaeumer.vscode-eslint",
      "nrwl.angular-console",
      "firsttris.vscode-jest-runner"
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "tty: qa",
        "type": "npm",
        "script": "tty:qa",
        "problemMatcher": [],
        "group": "qa"
      },
      {
        "label": "tty: build",
        "type": "npm",
        "script": "tty:build",
        "problemMatcher": [],
        "group": "build"
      },
      {
        "label": "tty-go: qa",
        "type": "npm",
        "script": "tty-go:qa",
        "problemMatcher": [],
        "group": "qa"
      },
      {
        "label": "demo-server: qa",
        "type": "npm",
        "script": "demo-server:qa",
        "problemMatcher": [],
        "group": "qa"
      },
      {
        "label": "demo-server: build",
        "type": "npm",
        "script": "demo-server:build",
        "problemMatcher": [],
        "group": "build"
      },
      {
        "label": "demo-server: start",
        "type": "npm",
        "script": "demo-server:start",
        "problemMatcher": [],
        "isBackground": true
      },
      {
        "label": "demo: qa",
        "type": "npm",
        "script": "demo:qa",
        "problemMatcher": [],
        "group": "qa"
      },
      {
        "label": "demo: build",
        "type": "npm",
        "script": "demo:build",
        "problemMatcher": [],
        "group": "build"
      },
      {
        "label": "demo: start",
        "type": "npm",
        "script": "demo:start",
        "problemMatcher": [],
        "isBackground": true
      },
      {
        "label": "protocol: qa",
        "type": "npm",
        "script": "protocol:qa",
        "problemMatcher": [],
        "group": "qa"
      },
      {
        "label": "protocol: build",
        "type": "npm",
        "script": "protocol:build",
        "problemMatcher": [],
        "group": "build"
      },
      {
        "label": "tty-node: qa",
        "type": "npm",
        "script": "tty-node:qa",
        "problemMatcher": [],
        "group": "qa"
      },
      {
        "label": "tty-node: build",
        "type": "npm",
        "script": "tty-node:build",
        "problemMatcher": [],
        "group": "build"
      }
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "type": "node-terminal",
        "request": "launch",
        "name": "mnci: build",
        "command": "npm run build",
        "cwd": "${workspaceFolder:trectui}",
        "presentation": {
          "group": "mnci",
          "order": 1
        }
      },
      {
        "type": "node-terminal",
        "request": "launch",
        "name": "mnci: test",
        "command": "npm run test",
        "cwd": "${workspaceFolder:trectui}",
        "presentation": {
          "group": "mnci",
          "order": 2
        }
      },
      {
        "type": "node-terminal",
        "request": "launch",
        "name": "mnci: lint",
        "command": "npm run lint",
        "cwd": "${workspaceFolder:trectui}",
        "presentation": {
          "group": "mnci",
          "order": 3
        }
      },
      {
        "type": "node-terminal",
        "request": "launch",
        "name": "mnci: typecheck",
        "command": "npm run typecheck",
        "cwd": "${workspaceFolder:trectui}",
        "presentation": {
          "group": "mnci",
          "order": 4
        }
      }
    ]
  }
}
