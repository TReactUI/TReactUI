{
  "name": "@trectui/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "build": "nx run-many -t build",
    "lint": "nx run-many -t lint",
    "test": "nx run-many -t test",
    "typecheck": "nx run-many -t typecheck",
    "affected": "nx affected -t lint,typecheck,test,build",
    "graph": "nx graph",
    "release:preview": "nx release --dry-run",
    "prepare": "husky",
    "format": "eslint . --fix --cache",
    "python:install": "node -e \"if(!require('node:fs').existsSync('requirements-dev.txt')){console.log('No Python projects - skipping.');process.exit(0)}const py=process.platform==='win32'?'python':'python3';process.exit(require('node:child_process').spawnSync(py+' -m pip install -r requirements-dev.txt',{stdio:'inherit',shell:true}).status ?? 1)\" && node -e \"const fs=require('node:fs'),path=require('node:path');const editableDirs=[...fs.globSync('apps/*/pyproject.toml'),...fs.globSync('python-packages/*/pyproject.toml'),...fs.globSync('libs/*/pyproject.toml')].map((p)=>path.dirname(p));const requirementsFiles=fs.globSync('apps/*/requirements.txt');if(editableDirs.length===0&&requirementsFiles.length===0){console.log('No Python projects - skipping.');process.exit(0)}const args=['-m','pip','install','--quiet',...editableDirs.flatMap((d)=>['-e',d]),...requirementsFiles.flatMap((f)=>['-r',f])];const py=process.platform==='win32'?'python':'python3';process.exit(require('node:child_process').spawnSync(py,args,{stdio:'inherit'}).status ?? 1)\"",
    "tty:qa": "nx run tty:lint && nx run tty:test",
    "tty:build": "nx run tty:build",
    "tty-go:qa": "nx run tty-go:lint && nx run tty-go:test",
    "demo-server:qa": "nx run demo-server:lint && nx run demo-server:test",
    "demo-server:build": "nx run demo-server:build",
    "demo-server:start": "nx run demo-server:start",
    "demo:qa": "nx run demo:lint && nx run demo:test",
    "demo:build": "nx run demo:build",
    "demo:start": "nx run demo:serve",
    "protocol:qa": "nx run protocol:lint && nx run protocol:test",
    "protocol:build": "nx run protocol:build",
    "tty-node:qa": "nx run tty-node:lint && nx run tty-node:test",
    "tty-node:build": "nx run tty-node:build"
  },
  "private": true,
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@babel/preset-react": "^7.14.5",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@mnci/eslint-config": ">=0.1.0 <1.0.0",
    "@nx-go/nx-go": "^4.1.1",
    "@nx/eslint": "23.2.0",
    "@nx/eslint-plugin": "23.2.0",
    "@nx/jest": "23.2.0",
    "@nx/js": "23.2.0",
    "@nx/react": "23.2.0",
    "@nx/rollup": "23.2.0",
    "@nx/vite": "23.2.0",
    "@nx/web": "23.2.0",
    "@rollup/plugin-url": "^8.0.2",
    "@svgr/rollup": "^8.1.0",
    "@swc-node/register": "1.11.1",
    "@swc/cli": "~0.8.1",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.18",
    "@swc/jest": "~0.2.38",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "@types/jest": "~30.0.0",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.0.0",
    "adm-zip": "^0.6.1",
    "axe-core": "^4.13.0",
    "babel-jest": "~30.3.0",
    "core-js": "^3.36.1",
    "eslint": "^10.8.0",
    "husky": "^9.1.7",
    "jest": "~30.3.0",
    "jest-axe": "^11.0.0",
    "jest-environment-jsdom": "~30.3.0",
    "jest-environment-node": "~30.3.0",
    "jest-util": "~30.3.0",
    "jiti": "2.4.2",
    "nx": "23.2.0",
    "rollup": "^4.14.0",
    "swc-loader": "0.1.15",
    "ts-jest": "^29.4.7",
    "ts-node": "10.9.1",
    "tslib": "^2.3.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/*"
  ],
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "nx": {
      "brace-expansion": "^5.0.9",
      "smol-toml": "^1.7.1"
    },
    "@nx/js": {
      "brace-expansion": "^5.0.9"
    },
    "@nx/eslint": {
      "brace-expansion": "^5.0.9"
    },
    "@nx/eslint-plugin": {
      "brace-expansion": "^5.0.9"
    },
    "@nx/workspace": {
      "brace-expansion": "^5.0.9"
    },
    "postcss": {
      "nanoid": "^3.3.18"
    },
    "brace-expansion@4.0.0 - 5.0.8": "^5.0.9",
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "axios": "^1.20.0"
  },
  "nx": {
    "includedScripts": [],
    "targets": {
      "lint": {
        "executor": "nx:run-commands",
        "cache": true,
        "options": {
          "command": "eslint . --cache --ignore-pattern \"apps/**\" --ignore-pattern \"libs/**\" --ignore-pattern \"packages/**\" --ignore-pattern \"python-packages/**\" --ignore-pattern package-lock.json",
          "cwd": "."
        }
      }
    }
  }
}
